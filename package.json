{
  "name": "overlens",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "\"$(git rev-parse --path-format=absolute --git-common-dir)/../../dev.sh\" 'bun dev.js'",
    "compile": "bun node_modules/@ape-egg/vibe-compiler/bin/vibe-compile.js",
    "publish:check": "cd package && npm pack --dry-run",
    "publish:overlens": "bun publish:check && ./scripts/publish.sh"
  },
  "dependencies": {
    "@ape-egg/codie": "^0.1.3",
    "@ape-egg/vibe": "^3.0.5"
  },
  "devDependencies": {
    "@ape-egg/vibe-compiler": "^3.0.5"
  },
  "vibe-compiler": {
    "source": "./",
    "output": "./compiled",
    "pages": "pages",
    "root": "pages",
    "spa": true,
    "elementsAsIs": true,
    "componentsAsIs": false,
    "skipFiles": [
      "package",
      "scripts",
      "api",
      "dev.js",
      "package.json",
      "bun.lock",
      "bun.lockb",
      "vercel.json",
      "implementation.md",
      "AGENTS.md",
      "README.md"
    ]
  }
}
